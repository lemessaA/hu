# AgriClimate AI — example environment (copy to `.env` in repo root or export before `docker compose`)

# Shared API key (FastAPI + Next.js BFF)
API_KEY=change-me

# Primary LLM — Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback — OpenAI-compatible HTTP API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional live weather (otherwise demo data + Redis cache still works)
OPENWEATHER_API_KEY=

# Backend (local dev without Docker)
# If you use `npm run deps:up`, Postgres is on host port 5433 → use localhost:5433 below.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/agriclimate
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Frontend BFF (local dev)
BACKEND_URL=http://localhost:8000
