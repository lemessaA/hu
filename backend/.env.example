# Server
PORT=4000
NODE_ENV=development

# Security — required in production; optional in development (set to disable check in dev only if empty)
API_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/climate_agent

# Redis (short-term memory: last 5 messages per conversation)
REDIS_URL=redis://localhost:6379

# OpenAI — if unset, backend uses deterministic demo responses (good for conference demos without keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000
